<Window x:Class="DevTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevTimer" Height="290" Width="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#0f1020">
    <StackPanel Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="ModeText" Text="Focus" Foreground="#60a5fa"
                   FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock x:Name="TimerText" Text="25:00" FontSize="72" FontWeight="Black"
                   Foreground="#e6e8f5" HorizontalAlignment="Center" FontFamily="Consolas"/>
        <TextBlock x:Name="SessionText" Text="Session 0" Foreground="#3a3d55"
                   FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Focus"  Click="BtnFocus_Click" Padding="10,4" Margin="0,0,4,0"/>
            <Button Content="Short"  Click="BtnShort_Click" Padding="10,4" Margin="0,0,4,0"/>
            <Button Content="Long"   Click="BtnLong_Click"  Padding="10,4"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="StartButton" Content="Start" Click="BtnStart_Click"
                    Padding="22,8" Margin="0,0,8,0" Background="#60a5fa"
                    Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="14"/>
            <Button Content="Reset" Click="BtnReset_Click" Padding="14,8"/>
        </StackPanel>
    </StackPanel>
</Window>

# Copy to .env.local for local development. Never commit real values.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# ── Admin (/admin) ─────────────────────────────────────────────
# Generate both with: npm run admin:credentials
# Only the scrypt hash is stored, never the password itself.
ADMIN_PASSWORD_HASH=
# Random key (≥ 32 characters) that signs the session cookie.
SESSION_SECRET=

# ── Content storage (Upstash Redis via Vercel Marketplace) ────
# Set automatically when the database is connected to the project in Vercel.
# Without them the site shows the built-in default content and the admin is read-only.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Contact form (Resend) ─────────────────────────────────────
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=enisshorra.ch
# CONTACT_EMAIL=

# ── Last.fm (optional, currently unused by any page) ─────────
# LASTFM_API_KEY=
# LASTFM_USERNAME=
